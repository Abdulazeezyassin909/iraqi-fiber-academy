rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // CMS media (article covers, avatars, inline images, etc.)
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /instructor_cvs/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
